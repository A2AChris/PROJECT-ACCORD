{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-accord:schema:public-semantic-dependencies:v0.1",
  "title": "PROJECT ACCORD Public Semantic Dependency Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "dependencies"
  ],
  "properties": {
    "schema": {
      "const": "accord.public-semantic-dependencies.v0.1"
    },
    "contract_revision": {
      "const": "v0.1"
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependent",
          "dependency",
          "kind"
        ],
        "properties": {
          "dependent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "revision"],
            "properties": {
              "id": {"type": "string", "pattern": "^ACCORD-C[0-9]{2}$"},
              "revision": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"}
            }
          },
          "dependency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "revision"],
            "properties": {
              "id": {"type": "string", "pattern": "^ACCORD-C[0-9]{2}$"},
              "revision": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"}
            }
          },
          "kind": {
            "const": "SEMANTIC_INTERPRETATION"
          }
        }
      }
    }
  }
}
