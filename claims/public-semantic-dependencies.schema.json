{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-accord.example/schema/public-semantic-dependency-registry.v0.1.json",
  "title": "PROJECT ACCORD public semantic dependency registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "accord.public-semantic-dependency-registry.v0.1"
    },
    "contract_revision": {
      "const": "v0.1"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependent_claim",
          "dependency_claims"
        ],
        "properties": {
          "dependent_claim": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ACCORD-C[0-9]{2}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^v[0-9]+\\.[0-9]+$"
              }
            }
          },
          "dependency_claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "relation",
                "public_rule_reference"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ACCORD-C[0-9]{2}$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^v[0-9]+\\.[0-9]+$"
                },
                "relation": {
                  "const": "SEMANTIC_INTERPRETATION"
                },
                "public_rule_reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        }
      }
    }
  }
}
