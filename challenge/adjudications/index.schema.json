{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-accord.example/schema/challenge-adjudication-index.v0.3.json",
  "title": "PROJECT ACCORD public challenge adjudication index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "accord.challenge-adjudication-index.v0.3"
    },
    "contract_revision": {
      "const": "v0.3"
    },
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^challenge/adjudications/records/[A-Za-z0-9._-]+\\.json$"
      }
    }
  }
}
