{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-accord.example/schema/challenge-adjudication-record.v0.1.json",
  "title": "PROJECT ACCORD public challenge adjudication record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adjudication_id",
    "challenge",
    "claim",
    "review_class",
    "disposition",
    "decision_detail"
  ],
  "properties": {
    "schema": {
      "const": "accord.challenge-adjudication-record.v0.1"
    },
    "adjudication_id": {
      "type": "string",
      "pattern": "^ACCORD-ADJ-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_sha256"
      ],
      "properties": {
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_artifact_path": {
          "type": "string",
          "pattern": "^challenge/submissions/[A-Za-z0-9._-]+\\.json$",
          "maxLength": 240
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "falsification_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ACCORD-C[0-9]{2}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "falsification_id": {
          "type": "string",
          "pattern": "^C[0-9]{2}-F[1-9][0-9]*$"
        }
      }
    },
    "review_class": {
      "type": "string",
      "enum": [
        "PROJECT_ADJUDICATED",
        "EXTERNAL_INDEPENDENT",
        "MULTI_PARTY_REVIEWED"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "CONFIRMED_FALSIFICATION",
        "REJECTED_OUT_OF_SCOPE",
        "INSUFFICIENT_EVIDENCE",
        "NOT_CONFIRMED"
      ]
    },
    "decision_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "public_rule_references",
        "evidence_references"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "public_rule_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "evidence_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "missing_evidence_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "falsification_analysis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "claim_id",
        "claim_revision"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "CLAIM_SUSPENDED",
            "CLAIM_WITHDRAWN",
            "CLAIM_SUPERSEDED"
          ]
        },
        "claim_id": {
          "type": "string",
          "pattern": "^ACCORD-C[0-9]{2}$"
        },
        "claim_revision": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "replacement_revision": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
